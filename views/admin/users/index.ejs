<%- include('../partials/head', { title: 'Usuarios' }) %>
<body class="hold-transition sidebar-mini layout-fixed">
<div class="wrapper">

<%- include('../partials/navbar') %>
<%- include('../partials/sidebar', { activePage: 'users' }) %>

<div class="content-wrapper">
  <div class="content-header">
    <div class="container-fluid">
      <div class="row mb-2">
        <div class="col-sm-6">
          <h1 class="m-0">Usuarios</h1>
        </div>
        <div class="col-sm-6">
          <ol class="breadcrumb float-sm-right">
            <li class="breadcrumb-item"><a href="/admin">Inicio</a></li>
            <li class="breadcrumb-item active">Usuarios</li>
          </ol>
        </div>
      </div>
    </div>
  </div>

  <div class="content">
    <div class="container-fluid">

      <% if (msg) { %>
        <div class="alert alert-info alert-dismissible fade show">
          <i class="fas fa-info-circle mr-2"></i><%= msg %>
          <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
        </div>
      <% } %>

      <div class="card">
        <div class="card-header">
          <form method="GET" action="/admin/users" class="d-flex align-items-center">
            <div class="input-group input-group-sm" style="max-width: 360px;">
              <input type="text" name="search" class="form-control" placeholder="Buscar por nombre, email o teléfono..." value="<%= search %>">
              <div class="input-group-append">
                <button type="submit" class="btn btn-default"><i class="fas fa-search"></i></button>
              </div>
            </div>
            <% if (search) { %>
              <a href="/admin/users" class="btn btn-sm btn-outline-secondary ml-2">
                <i class="fas fa-times"></i> Limpiar
              </a>
            <% } %>
          </form>
          <div class="card-tools">
            <span class="badge badge-secondary"><%= totalItems %> usuarios</span>
          </div>
        </div>

        <div class="card-body p-0">
          <div class="table-responsive">
            <table class="table table-hover table-striped mb-0">
              <thead class="thead-light">
                <tr>
                  <th style="width:40px"></th>
                  <th>Nombre</th>
                  <th>Teléfono</th>
                  <th>Email</th>
                  <th>Rol</th>
                  <th>Estado</th>
                  <th>Registro</th>
                  <th style="width:80px"></th>
                </tr>
              </thead>
              <tbody>
                <% if (users.length === 0) { %>
                  <tr>
                    <td colspan="8" class="text-center text-muted py-4">
                      <i class="fas fa-user-slash fa-2x mb-2 d-block"></i>
                      No se encontraron usuarios
                    </td>
                  </tr>
                <% } %>
                <% users.forEach(function(u) { %>
                  <tr>
                    <td class="text-center">
                      <img src="<%= u.image %>" alt="" class="user-avatar-sm">
                    </td>
                    <td><%= u.name || '—' %></td>
                    <td><%= u.phone || '—' %></td>
                    <td><%= u.email || '—' %></td>
                    <td>
                      <% if (u.role) { %>
                        <span class="badge badge-<%= u.role.name === 'SUPER_ROLE' ? 'danger' : u.role.name === 'ADMIN_ROLE' ? 'warning' : 'secondary' %>">
                          <%= u.role.name.replace('_ROLE', '') %>
                        </span>
                      <% } else { %>
                        <span class="text-muted">—</span>
                      <% } %>
                    </td>
                    <td>
                      <% if (u.status) { %>
                        <span class="badge badge-success"><i class="fas fa-check mr-1"></i>Activo</span>
                      <% } else { %>
                        <span class="badge badge-secondary"><i class="fas fa-ban mr-1"></i>Inactivo</span>
                      <% } %>
                    </td>
                    <td class="small text-muted"><%= new Date(u.createdAt).toLocaleDateString('es-MX') %></td>
                    <td>
                      <a href="/admin/users/<%= u.id %>" class="btn btn-sm btn-outline-primary">
                        <i class="fas fa-eye"></i>
                      </a>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>

        <% if (totalPages > 1) { %>
        <div class="card-footer clearfix">
          <div class="float-left small text-muted">
            Página <%= page %> de <%= totalPages %> &mdash; <%= totalItems %> registros
          </div>
          <ul class="pagination pagination-sm m-0 float-right">
            <li class="page-item <%= page <= 1 ? 'disabled' : '' %>">
              <a class="page-link" href="?page=<%= page - 1 %>&search=<%= search %>">&laquo;</a>
            </li>
            <% for (let p = Math.max(1, page - 2); p <= Math.min(totalPages, page + 2); p++) { %>
              <li class="page-item <%= p === page ? 'active' : '' %>">
                <a class="page-link" href="?page=<%= p %>&search=<%= search %>"><%= p %></a>
              </li>
            <% } %>
            <li class="page-item <%= page >= totalPages ? 'disabled' : '' %>">
              <a class="page-link" href="?page=<%= page + 1 %>&search=<%= search %>">&raquo;</a>
            </li>
          </ul>
        </div>
        <% } %>
      </div>

    </div>
  </div>
</div>

<footer class="main-footer">
  <strong>MakersLab Admin</strong> &copy; <%= new Date().getFullYear() %>
</footer>

</div>
<%- include('../partials/scripts') %>
</body>
</html>
