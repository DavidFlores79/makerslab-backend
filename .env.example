# Server
PORT=3000
NODE_ENV=development

# Database
MONGODB=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>

# JWT
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=2h

# CORS (comma-separated origins or * for all)
CORS_ORIGIN=*

# Cloudinary
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google OAuth
GOOGLE_CLIENT_ID=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL_TEXT=gpt-4o-mini
OPENAI_MODEL_VISION=gpt-4o

# Chat Limits
CHAT_MAX_MESSAGES_IN_DB=30
CHAT_MAX_MESSAGES_TO_AI=20
CHAT_MAX_USER_MESSAGES_PER_DAY=100

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30

# Mail (primary SMTP)
MAIL_FROM_NAME=
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_RECIPIENTS=

# SMTP2GO
SMTP2GO_FROM_NAME=
SMTP2GO_HOST=mail.smtp2go.com
SMTP2GO_PORT=587
SMTP2GO_USERNAME=
SMTP2GO_PASSWORD=

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# App
APP_NAME=MakersLab
APP_LOGO=https://www.congresopromocionsalud.com/assets/public/img/brand/logo_congreso.png
APP_BASE_URL=http://localhost:3000

# Feature Flags
ENABLE_CHAT_USAGE_TRACKING=true
ENABLE_EMAIL_NOTIFICATIONS=true

# User Limits
USER_MAX_PAYMENTS=2
USER_MAX_SUMMARIES=1

# Cache (node-cache)
CACHE_TTL=300
CACHE_CHECK_PERIOD=600

# Admin Panel Session
SESSION_SECRET=change_this_to_a_long_random_string_at_least_32_chars
ADMIN_SESSION_NAME=makerslab_admin_sid
HTTPS=true
